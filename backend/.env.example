# Cadena de conexión a Postgres. En Railway/Render te la dan lista;
# en local, usa la del docker-compose.yml de la raíz del repo.
DATABASE_URL=postgresql://iphonizate:iphonizate@localhost:5432/iphonizate

# Genera algo largo y aleatorio, por ejemplo con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Dominio(s) desde donde se sirve el frontend, separados por coma.
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000

# Usado solo por "npm run seed" para crear/actualizar el primer usuario.
SEED_USUARIO=renato
SEED_PIN=123456
SEED_NOMBRE=Renato
SEED_ROL=Admin
